{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"EvaluationResult v1", "type":"object", "additionalProperties":false,
  "required":["schema_version","run_id","sample_id","attempt_id","task_id","model","protocol","answer","reference","correct","annotation_status","steps","first_error","primary_error"],
  "properties":{
    "schema_version":{"const":"1.0"},"run_id":{"type":"string","minLength":1},"sample_id":{"type":"string","minLength":1},"attempt_id":{"type":"integer","minimum":0},"task_id":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"protocol":{"enum":["direct","reasoning"]},"answer":{"type":"string"},"reference":{"type":"string"},"correct":{"type":"boolean"},"annotation_status":{"enum":["reviewed","unreviewed"]},
    "steps":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["step_id","action","validity","error_type","evidence"],"properties":{"step_id":{"type":"integer","minimum":0},"action":{"type":"string","minLength":1},"validity":{"enum":["correct","incorrect","unknown"]},"error_type":{"type":["string","null"]},"evidence":{"type":"string"}}}},
    "first_error":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/error"}]},"primary_error":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/error"}]}
  },
  "definitions":{"error":{"type":"object","additionalProperties":false,"required":["step_id","type","evidence"],"properties":{"step_id":{"type":"integer","minimum":0},"type":{"type":"string","minLength":1},"evidence":{"type":"string","minLength":1}}}}
